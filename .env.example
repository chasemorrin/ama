# Copy this file to .env and fill in your own JSONBin.io access key.
# Use a read-only access key scoped to just the Claves bin - never the
# master key. See README.md for why, and for how to set the matching
# GitHub Actions secret for deployment.
#
# If your key contains $ characters (bcrypt-style keys look like
# $2a$10$...), escape each one as \$ - otherwise dotenv's
# variable-expansion feature will silently mangle the value.
# Example: VITE_JSONBIN_ACCESS_KEY=\$2a\$10\$therestofyourkeyhere
VITE_JSONBIN_ACCESS_KEY=
